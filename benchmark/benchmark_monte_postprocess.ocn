            ?section
            ,DFF_PVT_MODEL_SECTIONS
        )

        (
            "model"
            ,DFF_MODEL_FILE
            ?enabled nil
            ?section
            ,DFF_PRE_SIMU_SECTION
        )

        (
            "modelGroup"
            ""
        )
    )
)


ocnxlCorner(
    "MONTE"
    `(
        (
            "variable"
            "temperature"
            ,DFF_MONTE_TEMPERATURES
        )

        (
            "variable"
            "VDD"
            ,DFF_MONTE_VDD
        )

        (
            "model"
