;==============================================================================
; Load Project Configuration
;==============================================================================

DFF_CHAR_ROOT = getShellEnvVar(
    "DFF_CHAR_ROOT"
)

unless(
    DFF_CHAR_ROOT

    error(
        "ERROR: DFF_CHAR_ROOT environment variable is not set.\n"
    )
)

load(
    strcat(
        DFF_CHAR_ROOT
        "/config/config.il"
    )
)


;==============================================================================
; Set Maestro Mode
;==============================================================================

ocnSetXLMode(
    "assembler"
)

ocnxlProjectDir(
    DFF_PROJECT_DIR
)

ocnxlTargetCellView(
    DFF_LIBRARY
    DFF_CELL
    DFF_MAESTRO_VIEW
    ?mode "r"
)

ocnxlMaxJobFail(
    20
)


;==============================================================================
; Tests Setup
;==============================================================================


;------------------------------------------------------------------------------
; Setup-Time Characterization Test
;------------------------------------------------------------------------------

ocnxlBeginTest(
    DFF_SETUP_TEST_NAME
)

simulator(
    'spectre
)

design(
    DFF_LIBRARY
    DFF_CELL
    DFF_CONFIG_VIEW
)

modelFile(
    list(
        DFF_TOP_MODEL_FILE
        DFF_TOP_MODEL_SECTION
    )
)

analysis(
    'tran
    ?stop "2/VAR(\"frq\")"
    ?errpreset "conservative"
)

desVar(
    "frq"
    DFF_FREQUENCY
)

desVar(
    "CAP"
    DFF_LOAD_CAP
)

desVar(
    "SUB"
    DFF_SUB
)

desVar(
    "VDD"
    DFF_NOMINAL_VDD
)

desVar(
    DFF_HOLD_VARIABLE
    DFF_SETUP_TEST_HOLD
)

desVar(
    DFF_SETUP_VARIABLE
    DFF_SETUP_SWEEP
)

envOption(
    'analysisOrder
    list(
        "pz"
        "dcmatch"
        "stb"
        "tran"
        "envlp"
        "ac"
        "dc"
        "lf"
        "noise"
        "xf"
        "sp"
        "pss"
        "pac"
        "pstb"
        "pnoise"
        "pxf"
        "psp"
        "qpss"
        "qpac"
        "qpnoise"
        "qpxf"
        "qpsp"
        "hb"
        "hbac"
        "hbstb"
        "hbnoise"
        "hbxf"
        "sens"
        "acmatch"
    )
)

option(
    'pzSeverity   "None"
    'noiseSeverity "None"
    'spSeverity   "None"
    'acSeverity   "None"
    'dcOpSeverity "None"
    'dcSeverity   "None"
    'tranSeverity "None"
)

option(
    ?categ 'turboOpts
    'psrOption "Ultra Precision Analog"
    'psrSwitch t
    'apsplus t
    'uniMode "APS"
)

temp(
    27
)

; User-defined CLK-to-Q expression.
; Replace only the expression if your DUT uses different signal names.

ocnxlOutputExpr(
    "(cross(VT(\"/Q\") (VAR(\"VDD\") / 2) 1 \"rising\" nil nil nil) - cross(VT(\"/CLK\") (VAR(\"VDD\") / 2) 1 \"rising\" nil nil nil))"
    ?name DFF_CLK_TO_Q_OUTPUT
    ?plot t
    ?save t
)

ocnxlEndTest()


